+
+def deduplicate_argument(begins_with: str) -> None:
+    """Clean up duplicate arguments in sys.argv"""
+    log.info("Deduplicating %s from sys.argv" % begins_with)
+    dedup_target = -1
+    cleaned_argv = []
+    for arg in sys.argv:
+        if arg.startswith(begins_with):
+            if dedup_target != -1:
+                cleaned_argv[dedup_target] = arg
+                continue
+            dedup_target = len(cleaned_argv)
+        cleaned_argv.append(arg)
+    # Replace argv with cleaned up arguments if user provides an argument override
+    sys.argv = cleaned_argv
+    log.debug('Deduplicated commandline: ' + str(sys.argv))
