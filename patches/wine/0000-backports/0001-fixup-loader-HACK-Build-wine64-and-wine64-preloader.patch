From e9f032be6ff39cf021444e9b99081bd32769a3db Mon Sep 17 00:00:00 2001
From: Paul Gofman <pgofman@codeweavers.com>
Date: Wed, 29 Apr 2026 19:42:04 -0600
Subject: [PATCH 01/47] fixup! loader: HACK: Build wine64 and wine64-preloader.

CW-Bug-Id: #26438
CW-Bug-Id: #27009
---
 loader/main.c | 10 ++++++++++
 1 file changed, 10 insertions(+)

diff --git a/loader/main.c b/loader/main.c
index 0cceedfec9f..2775c078d96 100644
--- a/loader/main.c
+++ b/loader/main.c
@@ -154,6 +154,16 @@ static void *try_dlopen( const char *argv0 )
     void *handle;
 
     if (!argv0) return NULL;
+
+    if ((p = remove_tail( argv0, "i386-unix/wine64")))
+    {
+        path = build_path( p, "x86_64-unix/ntdll.so" );
+        free( p );
+        handle = dlopen( path, RTLD_NOW );
+        free( path );
+        return handle;
+    }
+
     if (!(dir = realpath_dirname( argv0 ))) return NULL;
 
     if ((p = remove_tail( dir, "/loader" )))
-- 
